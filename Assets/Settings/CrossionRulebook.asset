%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e0a220e7b42793840bf6efd5d6496ee4, type: 3}
  m_Name: CrossionRulebook
  m_EditorClassIdentifier: Assembly-CSharp::SkullKing.UI.RulebookContent
  illustratedLayout: 1
  pages:
  - title: "승리 횟수를 맞히는 카드게임"
    summary: "많이 이기는 것보다, 예측대로 이기는 게 중요해요!"
    body: "3~6명이 총 10라운드를 진행해요.\n1라운드는 1장, 2라운드는 2장…\n10라운드는 10장씩 받아요.\n\n모두 20점으로 시작해요.\n각 라운드의 점수를 더한 뒤,\n10라운드가 끝났을 때 점수가 가장 높으면 우승!\n\n기본 덱: 숫자 56장 + 특수 16장 = 72장"
    illustration: {fileID: 21300000, guid: 4ce2e99c502e9876950849345ea409ea, type: 3}
    illustrationCaption: "손패를 보고, 이번 라운드에\n몇 번 이길지 생각해 보세요."
    exampleA: "함께하는 사람\n3~6명"
    exampleB: "전체 진행\n10라운드"
    exampleC: "목표\n예측을 정확히!"
    exampleResult: "너무 많이 이겨도 예측과 다르면 실패예요."
  - title: "한 라운드는 이렇게 진행돼요"
    summary: "손패 확인 → 승리 수 예측 → 한 장씩 대결 → 점수!"
    body: "① 손패를 보고 이길 횟수를 예측해요.\n   이 예측을 ‘비딩’이라고 해요.\n② 차례대로 카드 한 장씩을 내요.\n   모두 한 장씩 낸 대결을 ‘트릭’이라고 해요.\n③ 승자는 승리 횟수 1회를 얻고,\n   다음 트릭에서 먼저 카드를 내요.\n④ 손패를 다 쓰면 예측과 실제 승리를 비교해요.\n\n예: 3라운드는 3장을 받아 3트릭을 진행해요."
    illustration: {fileID: 21300000, guid: 4ce2e99c502e9876950849345ea409ea, type: 3}
    illustrationCaption: "라운드는 여러 번의 작은 대결,\n트릭은 각자 한 장씩 내는 한 번의 대결이에요."
    exampleA: "1  손패 확인"
    exampleB: "2  이길 횟수 예측"
    exampleC: "3  한 장씩 대결"
    exampleResult: "예측한 횟수만큼만 이기는 것이 핵심!"
  - title: "숫자 카드는 같은 세계를 따라요"
    summary: "처음 나온 숫자 카드의 세계가 ‘기준 세계’예요."
    body: "숫자 카드는 네 세계에 각각 1~14가 있어요.\n무협 / 판타지 / 사이버펑크 / 공허\n\n기준 세계의 숫자 카드가 손에 있다면,\n숫자 카드를 낼 때는 그 세계를 따라야 해요.\n그 세계가 없다면 다른 세계를 내도 돼요.\n\n특수 카드는 기준 세계와 관계없이 낼 수 있어요.\n첫 카드가 특수라면, 처음 나온 숫자 카드가\n기준 세계를 정해요."
    illustration: {fileID: 21300000, guid: 29f1446a6c19c5a5aa039d93111b0577, type: 3}
    illustrationCaption: "세계는 카드 테두리와 문양으로 구분해요.\n숫자 카드와 같은 이름의 특수 카드는 달라요!"
    exampleA: "기준 세계\n무협"
    exampleB: "내 손에 무협이 있음\n무협 숫자로 따라가기"
    exampleC: "특수 카드가 있음\n특수 카드도 가능"
    exampleResult: "천사 규칙에서도 같은 세계를 따라 내는 의무는 유지돼요."
  - title: "숫자 카드끼리는 누가 이길까요?"
    summary: "공허 숫자 우선! 공허가 없으면 기준 세계의 최고 숫자!"
    body: "일반 판정에서는 공허 숫자가 다른 세계보다 강해요.\n공허가 여러 장이면 큰 숫자가 이겨요.\n\n공허가 없다면 기준 세계 숫자 중 큰 숫자가 이겨요.\n다른 세계의 큰 숫자는 기준 세계를 이기지 못해요.\n\n아래 예시의 기준 세계는 무협이에요.\n판타지 14보다 무협 10이 이겨요.\n\n특수 카드가 나오면 다음 페이지의 상성을 봐요."
    illustration: {fileID: 21300000, guid: 29f1446a6c19c5a5aa039d93111b0577, type: 3}
    illustrationCaption: "‘숫자가 크다’만 보지 말고,\n공허인지, 기준 세계인지 먼저 확인하세요."
    exampleA: "무협 숫자 7\n처음 나온 숫자"
    exampleB: "판타지 숫자 14\n다른 세계"
    exampleC: "무협 숫자 10\n기준 세계 최고"
    exampleResult: "이 예시의 승자: 무협 숫자 10"
  - title: "세 특수 세력은 서로 견제해요"
    summary: "사이버펑크 → 무협 → 판타지 → 사이버펑크"
    body: "이 페이지는 천사·종말 규칙이 없을 때예요.\n\n사이버펑크 특수는 무협 특수를 이겨요.\n무협 특수는 판타지 특수를 이겨요.\n판타지 특수는 사이버펑크 특수를 이겨요.\n\n이 세 종류의 특수 카드는 숫자 카드보다 강해요.\n같은 세계의 ‘숫자 카드’에는 이 상성이 없어요.\n\n세 종류가 모두 나오면? 다음 페이지를 보세요!"
    illustration: {fileID: 21300000, guid: 29f1446a6c19c5a5aa039d93111b0577, type: 3}
    illustrationCaption: "왼쪽부터 무협 / 판타지 / 사이버펑크.\n귀여워도 서로의 약점은 확실해요!"
    exampleA: "사이버펑크 특수\n무협에게 승리"
    exampleB: "무협 특수\n판타지에게 승리"
    exampleC: "판타지 특수\n사이버펑크에게 승리"
    exampleResult: "화살표는 ‘이긴다’는 뜻이에요. 세 종류 동시 출현은 예외!"
  - title: "셋 다 모이면 판타지가 이겨요"
    summary: "사이버펑크와 판타지가 함께 있으면 판타지 우선!"
    body: "무협·판타지·사이버펑크가 모두 나온 트릭에서는\n판타지 특수가 사이버펑크를 잡고 승리해요.\n무협이 있어도 이 예외가 우선이에요.\n\n같은 역할끼리는 먼저 낸 카드가 이겨요.\n예: 무협이 두 장 나오면 먼저 낸 무협이 승리!\n판타지 두 장도 같은 방식이에요.\n\n암살자가 무협 역할을 고르면 무협으로 취급해요.\n천사·종말이 있으면 그 특별 규칙을 먼저 봐요."
    illustration: {fileID: 21300000, guid: 29f1446a6c19c5a5aa039d93111b0577, type: 3}
    illustrationCaption: "단순한 가위바위보로만 외우면 안 돼요.\n셋 다 등장하는 경우를 기억하세요."
    exampleA: "무협 특수\n함께 등장"
    exampleB: "사이버펑크 특수\n함께 등장"
    exampleC: "판타지 특수\n이 트릭의 승자"
    exampleResult: "천사·종말이 없다면, 이 조합의 승자는 판타지!"
  - title: "암살자는 역할을 선택해요"
    summary: "공격할까요, 물러날까요? 낼 때 한 가지를 골라요."
    body: "암살자를 제출하면 두 역할 중 하나를 선택해요.\n\n무협 역할: 무협 특수와 같은 힘으로 싸워요.\n항복 역할: 이기지 않도록 물러나요.\n선택한 역할은 그 트릭 동안 바꿀 수 없어요.\n\n일반 항복 카드도 보통 다른 카드에게 져요.\n모두 항복 역할만 냈다면 먼저 낸 사람이 이겨요.\n\n승리가 필요할 때와 피하고 싶을 때를 구분하세요."
    illustration: {fileID: 21300000, guid: bfe61047f5920c41759e92035773dc2d, type: 3}
    illustrationCaption: "한쪽은 공격, 다른 쪽은 하얀 깃발.\n같은 카드도 선택에 따라 달라져요."
    exampleA: "암살자 제출"
    exampleB: "선택 1\n무협 역할로 공격"
    exampleC: "선택 2\n항복 역할로 회피"
    exampleResult: "두 역할 중 하나만 선택해요. 무협 역할도 제출 순서를 따라요."
  - title: "천사: 오직 숫자로 겨뤄요"
    summary: "세계의 우위와 특수 카드의 상성을 내려놓아요."
    body: "천사 규칙이 적용된 트릭은 숫자만 비교해요.\n공허 숫자의 우위도, 특수 카드의 힘도 사라져요.\n\n가장 큰 숫자 카드를 낸 사람이 승리해요.\n같은 최고 숫자가 겹치면 먼저 낸 카드가 이겨요.\n특수 카드는 숫자 0으로 취급해요.\n\n숫자 카드가 하나도 없다면 천사 제출자가 이겨요.\n단, 같은 세계를 따라 내는 의무는 그대로예요.\n종말도 함께 있다면 두 카드의 제출 순서를 봐요."
    illustration: {fileID: 21300000, guid: 499727353cd36f93876095910e672d7d, type: 3}
    illustrationCaption: "천사 앞에서는 공허 2보다 무협 14!\n강한 특수 카드도 숫자 카드를 이기지 못해요."
    exampleA: "공허 숫자 2"
    exampleB: "무협 숫자 14"
    exampleC: "천사\n숫자 비교로 변경"
    exampleResult: "천사가 마지막 특별 규칙이라면 무협 숫자 14 승리!"
  - title: "종말: 이 트릭은 무효!"
    summary: "아무도 승리 횟수를 얻지 못해요."
    body: "종말 규칙이 적용되면 그 트릭은 무효예요.\n누구도 승리 횟수 1회를 얻지 못해요.\n이미 낸 카드를 다시 손으로 돌리지는 않아요.\n\n다음 트릭의 첫 순서는 별도로 정해요.\n종말을 빼고 남은 카드로 판정했을 때\n이겼을 사람이 다음 트릭에서 먼저 내요.\n\n종말 제출자가 자동으로 다음 선이 되지는 않아요.\n천사도 있다면 다음 페이지의 순서 규칙을 봐요."
    illustration: {fileID: 21300000, guid: 499727353cd36f93876095910e672d7d, type: 3}
    illustrationCaption: "테이블을 뒤엎는 작은 종말!\n카드는 썼지만 승리 횟수는 늘지 않아요."
    exampleA: "각자 한 장 제출"
    exampleB: "종말 규칙 적용\n트릭 무효"
    exampleC: "승리 횟수\n모두 +0회"
    exampleResult: "종말을 제외하고 계산한 승자가 다음 트릭의 선을 맡아요."
  - title: "천사와 종말: 나중에 나온 쪽!"
    summary: "둘 중 마지막으로 제출된 카드의 규칙이 적용돼요."
    body: "천사 → 종말\n종말 규칙: 트릭 무효, 아무도 승리하지 못해요.\n다음 선은 종말을 제외하고 다시 판정해요.\n\n종말 → 천사\n천사 규칙: 무효 대신 최고 숫자로 승부해요.\n승자는 승리 횟수 1회와 다음 선을 얻어요.\n\n뒤에 일반 카드가 나와도 규칙은 바뀌지 않아요.\n두 경우 모두, 마지막 천사·종말만 기억하세요."
    illustration: {fileID: 21300000, guid: 499727353cd36f93876095910e672d7d, type: 3}
    illustrationCaption: "누가 더 세냐가 아니라, 누가 더 늦게 나왔냐!\n숫자 카드의 제출 순서와 헷갈리지 마세요."
    exampleA: "천사 → 종말\n트릭 무효"
    exampleB: "종말 → 천사\n최고 숫자 승리"
    exampleC: "그 뒤 일반 카드\n특별 규칙 유지"
    exampleResult: "천사·종말만 ‘나중 우선’, 같은 힘의 다른 카드는 ‘먼저 우선’!"
  - title: "1회 이상 예측했을 때의 점수"
    summary: "정확히 맞히면 예측 × 20점, 틀리면 차이 × -10점!"
    body: "예측 횟수와 실제 승리 횟수가 같으면 성공이에요.\n성공 점수 = 예측 횟수 × 20점\n\n다르면 실패예요. 더 이겨도, 덜 이겨도 실패!\n실패 점수 = 두 횟수의 차이 × -10점\n\n아래 세 가지 예시를 비교해 보세요.\n특수 카드를 잡았다는 이유로 추가 점수는 없어요."
    illustration: {fileID: 21300000, guid: 4ce2e99c502e9876950849345ea409ea, type: 3}
    illustrationCaption: "카드를 많이 가져오는 게임이 아니에요.\n내가 말한 횟수를 지키는 게임이에요."
    exampleA: "예측 3 / 실제 3\n+60점"
    exampleB: "예측 3 / 실제 1\n-20점"
    exampleC: "예측 3 / 실제 4\n-10점"
    exampleResult: "1회 이상 예측의 점수예요. 0회 예측은 계산이 달라요!"
  - title: "0회 예측은 라운드 번호가 중요해요"
    summary: "한 번도 이기지 않으면 성공! 한 번이라도 이기면 실패!"
    body: "0회 예측은 실제 승리가 0회여야 성공이에요.\n성공: 라운드 번호 × 10점\n실패: 라운드 번호 × -10점\n\n5라운드라면 성공 +50점, 실패 -50점이에요.\n실패했을 때 몇 번 이겼는지는 관계없어요.\n\n누적 점수는 0점보다 내려가지 않아요.\n10라운드 종료 후 누적 점수가 가장 높으면 우승!"
    illustration: {fileID: 21300000, guid: 4ce2e99c502e9876950849345ea409ea, type: 3}
    illustrationCaption: "후반 라운드의 0회 예측은 고위험·고보상!\n항복이나 암살자의 회피 역할도 활용해 보세요."
    exampleA: "5라운드 / 0회 예측"
    exampleB: "실제 승리 0회\n+50점"
    exampleC: "실제 승리 1회 이상\n-50점"
    exampleResult: "기억하기: 예측을 정확히, 기준 세계 확인, 특별 규칙은 순서 확인!"
