  m_Script: {fileID: 11500000, guid: e0a220e7b42793840bf6efd5d6496ee4, type: 3}
  m_Name: CrossionRulebook
  m_EditorClassIdentifier: Assembly-CSharp::SkullKing.UI.RulebookContent
  pages:
  - title: "\uAE30\uBCF8 \uC9C4\uD589"
    body: "\uBAA9\uD45C: \uC608\uCE21\uD55C \uC2B9\uB9AC \uD69F\uC218\uB97C \uC815\uD655\uD788
      \uB9DE\uCDB0 \uC810\uC218\uB97C \uBAA8\uC73C\uC138\uC694.\n\n\uCD1D 10\uB77C\uC6B4\uB4DC\uC785\uB2C8\uB2E4.
      1\uB77C\uC6B4\uB4DC\uB294 1\uC7A5, 2\uB77C\uC6B4\uB4DC\uB294 2\uC7A5\u202610\uB77C\uC6B4\uB4DC\uB294
      10\uC7A5\uC529 \uBC1B\uC2B5\uB2C8\uB2E4.\n\n1. \uC190\uD328\uB97C \uBCF4\uACE0
      \uC774\uBC88 \uB77C\uC6B4\uB4DC\uC5D0 \uC774\uAE38 \uD69F\uC218\uB97C \uC608\uCE21\uD569\uB2C8\uB2E4(\uBE44\uB529).\n2.
      \uC120\uBD80\uD130 \uC21C\uC11C\uB300\uB85C \uD55C \uC7A5\uC529 \uB0C5\uB2C8\uB2E4.
      \uBAA8\uB450 \uD55C \uC7A5\uC529 \uB0B8 \uBB36\uC74C\uC744 \u2018\uD2B8\uB9AD\u2019\uC774\uB77C
      \uD569\uB2C8\uB2E4.\n3. \uD2B8\uB9AD\uC758 \uC2B9\uC790\uAC00 \uC2B9\uB9AC
      \uD69F\uC218 1\uD68C\uB97C \uC5BB\uACE0 \uB2E4\uC74C \uD2B8\uB9AD\uC758 \uC120\uC774
      \uB429\uB2C8\uB2E4.\n4. \uC190\uD328\uB97C \uBAA8\uB450 \uC4F0\uBA74 \uC608\uCE21\uACFC
      \uC2E4\uC81C \uC2B9\uB9AC \uD69F\uC218\uC5D0 \uB530\uB77C \uC810\uC218\uB97C
      \uACC4\uC0B0\uD569\uB2C8\uB2E4.\n5. 10\uB77C\uC6B4\uB4DC \uC885\uB8CC \uD6C4
      \uB204\uC801 \uC810\uC218\uAC00 \uB192\uC740 \uC0AC\uB78C\uC774 \uC2B9\uB9AC\uD569\uB2C8\uB2E4.\n\n\uB3C4\uC6C0\uB9D0\xB7\uD53C\uB4DC\uBC31
      \uCC3D\uC744 \uC5F4\uC5B4\uB3C4 \uAC8C\uC784\uC740 \uBA48\uCD94\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uBA40\uD2F0\uD50C\uB808\uC774\uC5D0\uC11C\uB294 \uB0B4 \uCC28\uB840\uB97C
      \uB193\uCE58\uC9C0 \uC54A\uB3C4\uB85D \uC8FC\uC758\uD558\uC138\uC694."
  - title: "\uC22B\uC790 \uCE74\uB4DC\uC640 \uC81C\uCD9C"
    body: "\uC22B\uC790\uB294 1~14\uC785\uB2C8\uB2E4.\n\n\uD2B8\uB9AD\uC5D0\uC11C
      \uCC98\uC74C \uB098\uC628 \uC22B\uC790 \uCE74\uB4DC\uC758 \uC0C9\uC774 \u2018\uB9AC\uB4DC
      \uC0C9\u2019\uC785\uB2C8\uB2E4. \uADF8 \uC0C9\uC758 \uC22B\uC790 \uCE74\uB4DC\uAC00
      \uC190\uC5D0 \uC788\uC73C\uBA74, \uC22B\uC790 \uCE74\uB4DC\uB97C \uB0BC \uB54C\uB294
      \uADF8 \uC0C9\uC744 \uB530\uB77C\uC57C \uD569\uB2C8\uB2E4. \uD574\uB2F9 \uC0C9\uC774
      \uC5C6\uC73C\uBA74 \uB2E4\uB978 \uC0C9\uC744 \uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uD2B9\uC218 \uCE74\uB4DC\uB294 \uC5B8\uC81C\uB4E0 \uB0BC \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC77C\uBC18
      \uD310\uC815\n\u2022 \uAC80\uC815 \uC22B\uC790 \uCE74\uB4DC\uB294 \uB2E4\uB978
      \uC0C9 \uC22B\uC790\uBCF4\uB2E4 \uAC15\uD569\uB2C8\uB2E4.\n\u2022 \uAC80\uC815\uC774
      \uC5C6\uB2E4\uBA74 \uB9AC\uB4DC \uC0C9\uC758 \uC22B\uC790 \uC911 \uAC00\uC7A5
      \uB192\uC740 \uC22B\uC790\uAC00 \uC774\uAE41\uB2C8\uB2E4.\n\u2022 \uAC19\uC740
      \uC0C9\uC740 \uD070 \uC22B\uC790\uAC00 \uC774\uAE41\uB2C8\uB2E4. \uC22B\uC790
      \uB3D9\uC810\uC740 \uBA3C\uC800 \uB0B8 \uCE74\uB4DC\uAC00 \uC6B0\uC120\uC785\uB2C8\uB2E4.\n\n\uCC9C\uC0C1\uAC15\uB9BC
      \uB8F0\uC774 \uC801\uC6A9\uB418\uBA74 \uC0C9\uACFC \uAC80\uC815\uC758 \uC6B0\uC704\uB97C
      \uBB34\uC2DC\uD558\uACE0 \uC624\uC9C1 \uC22B\uC790\uB9CC \uBE44\uAD50\uD569\uB2C8\uB2E4.
      \uB2E8, \uB9AC\uB4DC \uC0C9\uC744 \uB530\uB77C \uC81C\uCD9C\uD558\uB294 \uC758\uBB34\uB294
      \uADF8\uB300\uB85C\uC785\uB2C8\uB2E4.\n\n\uB9C8\uC6B0\uC2A4\uB85C \uC190\uD328\uB97C
      \uC120\uD0DD\uD574 \uC81C\uCD9C\uD569\uB2C8\uB2E4. \uCE74\uB4DC \uC704\uC5D0\uC11C
      Alt\uB97C \uB204\uB974\uBA74 \uD06C\uAC8C \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - title: "\uD2B9\uC218 \uCE74\uB4DC"
    body: "\uD574\uC801: \uC22B\uC790 \uCE74\uB4DC\uC640 \uC778\uC5B4\uB97C \uC774\uAE41\uB2C8\uB2E4.\n\uC2A4\uCEEC\uD0B9:
      \uD574\uC801\uACFC \uC22B\uC790 \uCE74\uB4DC\uB97C \uC774\uAE41\uB2C8\uB2E4.\n\uC778\uC5B4:
      \uC2A4\uCEEC\uD0B9\uC744 \uC7A1\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC2A4\uCEEC\uD0B9\uC774
      \uC5C6\uB294 \uD2B8\uB9AD\uC5D0\uC11C\uB294 \uD574\uC801\uC5D0\uAC8C \uC9D1\uB2C8\uB2E4.\n\uAC19\uC740
      \uC5ED\uD560\uC758 \uD2B9\uC218 \uCE74\uB4DC\uB07C\uB9AC\uB294 \uBA3C\uC800
      \uB0B8 \uCE74\uB4DC\uAC00 \uC6B0\uC120\uC785\uB2C8\uB2E4.\n\n\uD0C0\uC774\uADF8\uB9AC\uC2A4:
      \uC81C\uCD9C \uC2DC \uD574\uC801 \uB610\uB294 \uD56D\uBCF5 \uC5ED\uD560\uC744
      \uC120\uD0DD\uD569\uB2C8\uB2E4.\n\uD56D\uBCF5: \uBCF4\uD1B5 \uB2E4\uB978 \uCE74\uB4DC\uC5D0
      \uC9D1\uB2C8\uB2E4. \uBAA8\uB450 \uD56D\uBCF5 \uC5ED\uD560\uC774\uBA74 \uBA3C\uC800
      \uB0B8 \uC0AC\uB78C\uC774 \uC774\uAE41\uB2C8\uB2E4.\n\uD2B9\uC218 \uD56D\uBCF5(\uBCF4\uC11D):
      \uD56D\uBCF5 \uC5ED\uD560\uC774\uBA70, \uC720\uD6A8\uD55C \uD2B8\uB9AD\uC758
      \uC2B9\uC790\uC640 \uB3D9\uB9F9\uC744 \uB9FA\uC2B5\uB2C8\uB2E4. \uC790\uC2E0\uC774
      \uC2B9\uC790\uC774\uBA74 \uC790\uC2E0\uACFC \uB3D9\uB9F9\uC744 \uB9FA\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uD06C\uB77C\uCF04: \uD2B8\uB9AD\uC744 \uBB34\uD6A8\uB85C
      \uB9CC\uB4E4\uC5B4 \uC544\uBB34\uB3C4 \uC2B9\uB9AC \uD69F\uC218\uB97C \uC5BB\uC9C0
      \uBABB\uD569\uB2C8\uB2E4.\n\uCC9C\uC0C1\uAC15\uB9BC(\uBC31\uACBD): \uC0C9\uACFC
      \uD2B9\uC218 \uB2A5\uB825 \uB300\uC2E0 \uCD5C\uACE0 \uC22B\uC790\uB85C \uC2B9\uBD80\uD569\uB2C8\uB2E4.
      \uC22B\uC790\uAC00 \uD558\uB098\uB3C4 \uC5C6\uC73C\uBA74 \uCC9C\uC0C1\uAC15\uB9BC\uC744
      \uB0B8 \uC0AC\uB78C\uC774 \uC774\uAE41\uB2C8\uB2E4.\n\n\uD06C\uB77C\uCF04\uACFC
      \uCC9C\uC0C1\uAC15\uB9BC\uC774 \uAC19\uC774 \uB098\uC624\uBA74 \uB2E4\uC74C
      \uD398\uC774\uC9C0\uC758 \uD2B9\uBCC4 \uADDC\uCE59\uC744 \uC801\uC6A9\uD569\uB2C8\uB2E4."
  - title: "\uD06C\uB77C\uCF04 \xB7 \uCC9C\uC0C1\uAC15\uB9BC"
    body: "\uB450 \uCE74\uB4DC \uC911 \uB098\uC911\uC5D0 \uC81C\uCD9C\uB41C \uCE74\uB4DC\uC758
      \uB8F0\uC774 \uC6B0\uC120\uC785\uB2C8\uB2E4.\n\n\uCC9C\uC0C1\uAC15\uB9BC \u2192
      \uD06C\uB77C\uCF04\n\uD06C\uB77C\uCF04 \uB8F0: \uD2B8\uB9AD \uBB34\uD6A8. \uC544\uBB34\uB3C4
      \uC2B9\uB9AC \uD69F\uC218\uB97C \uC5BB\uC9C0 \uBABB\uD569\uB2C8\uB2E4. \uB2E4\uC74C
      \uC120\uC740 \uD06C\uB77C\uCF04\uC744 \uC81C\uC678\uD558\uACE0 \uD310\uC815\uD588\uC744
      \uB54C \uC774\uACBC\uC744 \uC0AC\uB78C\uC774 \uB9E1\uC2B5\uB2C8\uB2E4. \uCC9C\uC0C1\uAC15\uB9BC\uC774
      \uB0A8\uC544 \uC788\uC73C\uBBC0\uB85C \uCD5C\uACE0 \uC22B\uC790\uB97C \uB0B8
      \uC0AC\uB78C\uC774 \uB2E4\uC74C \uC120\uC774 \uB429\uB2C8\uB2E4.\n\n\uD06C\uB77C\uCF04
      \u2192 \uCC9C\uC0C1\uAC15\uB9BC\n\uCC9C\uC0C1\uAC15\uB9BC \uB8F0: \uBB34\uD6A8\uAC00
      \uCDE8\uC18C\uB418\uACE0 \uC815\uC0C1\uC801\uC73C\uB85C \uC2B9\uC790\uB97C
      \uC815\uD569\uB2C8\uB2E4. \uCD5C\uACE0 \uC22B\uC790\uB97C \uB0B8 \uC0AC\uB78C\uC774
      \uC2B9\uB9AC \uD69F\uC218 1\uD68C\uB97C \uC5BB\uACE0 \uB2E4\uC74C \uC120\uC774
      \uB429\uB2C8\uB2E4.\n\n\uC774\uD6C4 \uC77C\uBC18 \uCE74\uB4DC\uAC00 \uB098\uC640\uB3C4
      \uC120\uD0DD\uB41C \uB8F0\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4. \uC22B\uC790
      \uB3D9\uC810\uC740 \uBA3C\uC800 \uB0B8 \uCE74\uB4DC\uAC00 \uC6B0\uC120\uC774\uBA70,
      \uC22B\uC790\uAC00 \uC5C6\uC73C\uBA74 \uCC9C\uC0C1\uAC15\uB9BC \uC81C\uCD9C\uC790\uAC00
      \uC120\uD0DD\uB429\uB2C8\uB2E4.\n\n\uC608: \uAC80\uC815 2 / \uCD08\uB85D 14
      / \uD06C\uB77C\uCF04 / \uCC9C\uC0C1\uAC15\uB9BC\n\u2192 \uCD08\uB85D 14 \uC2B9\uB9AC.\n\uAC19\uC740
      \uC870\uD569\uC5D0\uC11C \uD06C\uB77C\uCF04\uC774 \uCC9C\uC0C1\uAC15\uB9BC\uBCF4\uB2E4
      \uB098\uC911\uC774\uBA74\n\u2192 \uD2B8\uB9AD \uBB34\uD6A8, \uCD08\uB85D 14\uAC00
      \uB2E4\uC74C \uC120."
  - title: "\uC810\uC218\uC640 \uBCF4\uC11D \uB3D9\uB9F9"
    body: "\uC608\uCE21 \uD69F\uC218 = \uC2E4\uC81C \uC2B9\uB9AC \uD69F\uC218\uC774\uBA74
      \uC131\uACF5\uC785\uB2C8\uB2E4.\n\n1\uD68C \uC774\uC0C1 \uC608\uCE21\n\uC131\uACF5:
      \uC608\uCE21 \uD69F\uC218 \xD7 20\uC810\n\uC2E4\uD328: \uC608\uCE21\uACFC \uC2E4\uC81C
      \uD69F\uC218\uC758 \uCC28\uC774 \xD7 -10\uC810\n\uC608: 3\uD68C \uC608\uCE21\xB73\uD68C
      \uC2B9\uB9AC \u2192 +60\uC810\n\uC608: 3\uD68C \uC608\uCE21\xB71\uD68C \uC2B9\uB9AC
      \u2192 -20\uC810\n\n0\uD68C \uC608\uCE21\n\uC131\uACF5: \uB77C\uC6B4\uB4DC
      \uBC88\uD638 \xD7 10\uC810\n\uC2E4\uD328: \uB77C\uC6B4\uB4DC \uBC88\uD638 \xD7
      -10\uC810\n\uC608: 5\uB77C\uC6B4\uB4DC 0\uD68C \uC131\uACF5 \u2192 +50\uC810,
      \uC2E4\uD328 \u2192 -50\uC810\n\n\uBCF4\uC11D \uB3D9\uB9F9\n\uAC19\uC740 \uB77C\uC6B4\uB4DC\uC5D0
      \uB3D9\uB9F9\uC744 \uB9FA\uC740 \uC591\uCABD\uC774 \uBAA8\uB450 \uC608\uCE21\uC5D0
      \uC131\uACF5\uD558\uBA74 \uAC01\uC790 \uB3D9\uB9F9\uB2F9 +20\uC810\uC744 \uBC1B\uC2B5\uB2C8\uB2E4.
      \uD55C\uCABD\uC774\uB77C\uB3C4 \uC2E4\uD328\uD558\uBA74 \uB3D9\uB9F9 \uC810\uC218\uB294
      \uC5C6\uC2B5\uB2C8\uB2E4. \uB3D9\uB9F9\uC740 \uB2E4\uC74C \uB77C\uC6B4\uB4DC\uC5D0
      \uCD08\uAE30\uD654\uB429\uB2C8\uB2E4.\n\n\uB204\uC801 \uC810\uC218\uB294 0\uC810
      \uBBF8\uB9CC\uC73C\uB85C \uB0B4\uB824\uAC00\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uD2B9\uC218 \uCE74\uB4DC \uD3EC\uD68D \uBCF4\uB108\uC2A4\uB294 \uC0AC\uC6A9\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
